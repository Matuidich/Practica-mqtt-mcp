# Fuente compartida: python -B -m iot_shared init genera .env una sola vez.
# Formato reducido: KEY=VALUE, comentarios en líneas propias, sin comillas.
# PROJECT_UUID y el último nivel del prefijo deben coincidir.
PROJECT_UUID=REEMPLAZAR_CON_UUID
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_KEEPALIVE_S=60

# init sustituye el marcador por un único UUID v4 generado localmente.
# El prefijo evita colisiones; no es una contraseña ni proporciona privacidad.
MQTT_TOPIC_PREFIX=sis234/2026/REEMPLAZAR_CON_UUID
# Los client_id se derivan del UUID y el rol; no se editan por separado.

MQTT_RECONNECT_MIN_DELAY_S=1
MQTT_RECONNECT_MAX_DELAY_S=32
DISTANCE_PUBLISH_INTERVAL_MS=1000
DISTANCE_STALE_AFTER_S=10
SERVO_MIN_ANGLE=0
SERVO_MAX_ANGLE=180

# HiveMQ público no requiere usuario ni contraseña.
# No colocar aquí credenciales Wi-Fi ni claves de OpenAI.
# Tras editar .env: python -B -m iot_shared sync y después check.
