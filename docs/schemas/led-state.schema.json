{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIS-234 LedState",
  "type": "object",
  "required": [
    "leds",
    "command_id",
    "device_id",
    "uptime_ms",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "leds": {
      "type": "object",
      "properties": {
        "red": {
          "type": "boolean"
        },
        "yellow": {
          "type": "boolean"
        },
        "green": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "required": [
        "red",
        "yellow",
        "green"
      ]
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "minLength": 1,
      "maxLength": 64
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "minLength": 1,
      "maxLength": 64
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "status": {
      "const": "applied"
    }
  }
}
