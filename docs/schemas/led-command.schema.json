{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIS-234 LedCommand",
  "type": "object",
  "required": [
    "command_id",
    "leds"
  ],
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "minLength": 1,
      "maxLength": 64
    },
    "leds": {
      "type": "object",
      "properties": {
        "red": {
          "type": "boolean"
        },
        "yellow": {
          "type": "boolean"
        },
        "green": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  }
}
